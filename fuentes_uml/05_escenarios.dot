digraph CasosUso {
  graph [rankdir=LR, fontname="Arial", bgcolor="white", label="Vista +1 · Escenarios / Casos de uso", labelloc=t, fontsize=20, fontcolor="#23314d", pad=".3", ranksep="1.0", nodesep=".28"];
  node [fontname="Arial", fontsize=12];
  edge [dir=none, color="#697991", penwidth=1.3];
  visitante [shape=box, style="rounded,filled", fillcolor="#ffe0ec", color="#d8779a", label="«actor»\nVisitante / cliente"];
  usuario [shape=box, style="rounded,filled", fillcolor="#ffe0ec", color="#d8779a", label="«actor»\nUsuario con perfil demo"];
  admin [shape=box, style="rounded,filled", fillcolor="#ffe0ec", color="#d8779a", label="«actor»\nAdministrador demo"];
  subgraph cluster_sitio {
   label="Sistema Sockbuster"; fontname="Arial"; fontsize=15; style="rounded,dashed"; color="#8d9cbd";
   node [shape=ellipse, style=filled, fillcolor="#edf1fa", color="#9ba8c4", margin=".24,.14"];
   catalogo [label="RF01 · Ver y filtrar\ncatálogo"];
   carrito [label="RF02 · Agregar al carrito\ny modificar cantidades"];
   compra [label="RF02 · Simular pago\ny obtener número de pedido"];
   perfil [label="Crear perfil de ejemplo"];
   resena [label="RF04 · Publicar reseña\ny estrellas (1 a 5)"];
   editar [label="RF03 · Agregar modelos\ny editar stock/precio"];
  }
  visitante -> catalogo; visitante -> carrito; visitante -> compra;
  usuario -> perfil; usuario -> resena; usuario -> catalogo;
  admin -> editar;
}
